# Finova Environment Variables Template
# Copy this file to backend/.env and frontend/.env respectively and fill with your actual credentials.

# ---------------------------------------------
# BACKEND CONFIGURATION (.env in /backend)
# ---------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/finova

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

CLIENT_URL=http://localhost:5173

# Cloudinary Media Storage (Keep API Secret Private!)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Mock / Razorpay / UPI)
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

ADMIN_EMAIL=admin@finova.app
ADMIN_PASSWORD=admin123

# ---------------------------------------------
# FRONTEND CONFIGURATION (.env in /frontend)
# ---------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_URL=http://localhost:5173
